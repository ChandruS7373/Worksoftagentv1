# ── AI Providers (at least one required) ─────────────────────────────────────
GROQ_API_KEY=sk-...                  # Free at console.groq.com (recommended)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
AI_PROVIDER=groq                     # groq | claude | openai | gemini

# ── Salesforce (optional) ────────────────────────────────────────────────────
SF_USERNAME=user@example.com
SF_PASSWORD=yourpassword
SF_SECURITY_TOKEN=yourtoken
SF_CLIENT_ID=...
SF_CLIENT_SECRET=...
SF_DOMAIN=login                      # or your custom SF domain

# ── Slack (optional) ─────────────────────────────────────────────────────────
# Option A: Incoming Webhook (simpler — create at api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Option B: Bot Token (needs chat:write scope)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#support-escalations   # Channel to post escalation alerts

# ── Confluence (optional) ────────────────────────────────────────────────────
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_URL=https://yourorg.atlassian.net
CONFLUENCE_EMAIL=you@yourorg.com
CONFLUENCE_API_TOKEN=your_api_token_here
CONFLUENCE_SPACE_KEY=WS              # Space key to sync (leave blank for all spaces)

# ── Email Notifications (optional) ───────────────────────────────────────────
OUTLOOK_EMAIL=admin@yourorg.com
OUTLOOK_PASSWORD=yourpassword
IT_ADMIN_EMAIL=it-admin@yourorg.com

# ── GitHub DB Sync (optional) ────────────────────────────────────────────────
GH_TOKEN=ghp_...
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_DB_PATH=worksoft_support.db

# ── App Settings ─────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-in-production
